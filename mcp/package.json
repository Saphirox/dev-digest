{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server — stdio, thin HTTP client over the local DevDigest API. Exposes list_agents, run_agent_on_pr, get_findings, get_conventions, get_blast_radius (stub).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
