{
  "mcpServers": {
    "devdigest": {
      "type": "stdio",
      "command": "node",
      "args": ["mcp/node_modules/tsx/dist/cli.mjs", "mcp/src/server.ts"],
      "env": {
        "DEVDIGEST_API_URL": "${DEVDIGEST_API_URL:-http://localhost:3001}",
        "DEVDIGEST_MCP_WAIT_MS": "${DEVDIGEST_MCP_WAIT_MS:-100000}"
      }
    }
  }
}
