{
  "$comment": "Which skill reviews which changed files. Array order = ownership precedence when two skills flag the same line (the earlier one keeps the finding, later ones are folded into it). `include` globs route by path; `triggers` route by an added line matching `pattern`, but only for paths in `scope`; `fallback` skills get the files no other skill took. Every directory under .claude/skills must appear here or in `excluded`, or the run reports an `unrouted-skill` warning.",
  "skills": [
    {
      "skill": "security",
      "include": ["server/src/**/*.ts", "reviewer-core/src/**/*.ts", "client/src/app/**/route.ts", "client/src/middleware.ts"],
      "exclude": ["server/src/db/migrations/**"],
      "triggers": [
        {
          "pattern": "dangerouslySetInnerHTML|\\beval\\(|new Function\\(|child_process|execSync|exec\\(|spawn\\(|innerHTML|secret|token|password|cookie|authorization|process\\.env",
          "scope": ["**/*.{ts,tsx,mjs,cjs,js}"]
        }
      ]
    },
    {
      "skill": "onion-architecture",
      "include": ["server/src/**/*.ts", "reviewer-core/src/**/*.ts", "server/test/**/*.ts"],
      "exclude": ["server/src/db/migrations/**"]
    },
    {
      "skill": "postgresql-table-design",
      "include": ["server/src/db/schema/**/*.ts", "server/src/db/schema.ts", "server/src/db/migrations/*.sql"]
    },
    {
      "skill": "drizzle-orm-patterns",
      "include": ["server/src/**/repository.ts", "server/src/**/repository/**/*.ts", "server/src/db/**/*.ts"],
      "exclude": ["server/src/db/migrations/**"],
      "triggers": [{ "pattern": "drizzle-orm", "scope": ["server/src/**/*.ts", "server/test/**/*.ts"] }]
    },
    {
      "skill": "fastify-best-practices",
      "include": ["server/src/modules/**/routes.ts", "server/src/app.ts", "server/src/server.ts", "server/src/platform/**/*.ts"],
      "triggers": [{ "pattern": "\\bfastify\\b|FastifyInstance|reply\\.(code|status|send|header)", "scope": ["server/src/**/*.ts"] }]
    },
    {
      "skill": "zod",
      "include": ["server/src/vendor/shared/**/*.ts", "client/src/vendor/shared/**/*.ts"],
      "triggers": [{ "pattern": "\\bz\\.(object|string|number|boolean|enum|array|union|discriminatedUnion|infer|literal|record)\\b|safeParse\\(", "scope": ["**/*.{ts,tsx}"] }]
    },
    {
      "skill": "next-best-practices",
      "include": ["client/src/app/**/*.{ts,tsx}", "client/next.config.*", "client/src/middleware.ts"],
      "exclude": ["**/*.test.{ts,tsx}"]
    },
    {
      "skill": "frontend-ui-architecture",
      "include": ["client/src/**/*.{ts,tsx}"],
      "exclude": ["client/src/vendor/**", "**/*.test.{ts,tsx}"]
    },
    {
      "skill": "react-best-practices",
      "include": ["client/src/**/*.tsx"],
      "exclude": ["client/src/vendor/**", "**/*.test.tsx"]
    },
    {
      "skill": "react-testing-library",
      "include": ["client/src/**/*.test.{ts,tsx}"]
    },
    {
      "skill": "typescript-expert",
      "fallback": true,
      "include": ["**/*.{ts,tsx,mts,mjs}"],
      "exclude": ["**/vendor/shared/**", ".claude/**"]
    }
  ],
  "excluded": {
    "git-rebase-sync": "git workflow around commits; nothing to check in a diff",
    "engineering-insights": "maintains INSIGHTS.md; not a code-review skill",
    "mermaid-diagram": "authoring diagrams; nothing to check in a diff",
    "pr-self-review": "this skill",
    "staged-changes-review": "staged-only mode of this skill; a workflow, not a review rulebook"
  }
}
