+export interface Order {
+  subtotal: number; // in cents
+  coupon?: string;
+  isFirstOrder?: boolean;
+}
+
+const COUPONS: Record<string, number> = { SAVE10: 0.1, SAVE25: 0.25 };
+
+/**
+ * Discount in cents for an order. Orders of 100.00 or more get 5% off; a known
+ * coupon replaces that rate; a first order adds a flat 5.00. The discount never
+ * exceeds the subtotal.
+ */
+export function discountFor(order: Order): number {
+  if (order.subtotal < 0) {
+    throw new RangeError('subtotal must not be negative');
+  }
+  const couponRate = order.coupon ? COUPONS[order.coupon.toUpperCase()] : undefined;
+  const rate = couponRate ?? (order.subtotal >= 10_000 ? 0.05 : 0);
+  let discount = Math.round(order.subtotal * rate);
+  if (order.isFirstOrder) {
+    discount += 500;
+  }
+  return Math.min(discount, order.subtotal);
+}
